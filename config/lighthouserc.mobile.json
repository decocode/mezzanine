{
  "ci": {
    "collect": {
      "staticDistDir": "./site-dist",
      "isSinglePageApplication": true,
      "numberOfRuns": 3,
      "url": [
        "http://localhost/",
        "http://localhost/button",
        "http://localhost/table",
        "http://localhost/tabs",
        "http://localhost/navbar",
        "http://localhost/tooltip",
        "http://localhost/site/lab"
      ],
      "settings": {
        "onlyCategories": ["performance"],
        "chromeFlags": "--headless --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.65 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 5000 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.25 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 800 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "speed-index": ["warn", { "maxNumericValue": 5000 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 4000000 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 650000 }],
        "resource-summary:image:size": ["warn", { "maxNumericValue": 3000000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./reports/lighthouse/mobile"
    }
  }
}
