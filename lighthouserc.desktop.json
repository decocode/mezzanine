{
  "ci": {
    "collect": {
      "staticDistDir": "./site-dist",
      "isSinglePageApplication": true,
      "numberOfRuns": 3,
      "url": [
        "http://localhost/",
        "http://localhost/introduction",
        "http://localhost/color",
        "http://localhost/typography",
        "http://localhost/table",
        "http://localhost/button",
        "http://localhost/navigation-tree"
      ],
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance"],
        "chromeFlags": "--headless --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.75 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.25 }],
        "total-blocking-time": ["error", { "maxNumericValue": 600 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "speed-index": ["warn", { "maxNumericValue": 4000 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 4000000 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 650000 }],
        "resource-summary:image:size": ["warn", { "maxNumericValue": 3000000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./reports/lighthouse/desktop"
    }
  }
}
