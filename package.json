{
  "name": "@decocode/mezzanine",
  "version": "0.0.0",
  "private": true,
  "description": "Mezzanine — an accessible, token-themed React Aria design system by DecoCode Ltd.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/mezzanine.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:site",
    "build:lib": "vite build --config config/vite.lib.config.ts && tsc -p config/tsconfig.lib.json",
    "build:site": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "check:rules": "node --test --test-reporter=dot \"scripts/*.test.mjs\" && node scripts/check-rules.mjs",
    "preview": "vite preview",
    "lighthouse": "npm run build:site && npm run lighthouse:mobile:run && npm run lighthouse:desktop:run",
    "lighthouse:mobile": "npm run build:site && npm run lighthouse:mobile:run",
    "lighthouse:mobile:run": "node scripts/run-lighthouse.mjs autorun --config=./config/lighthouserc.mobile.json",
    "lighthouse:desktop": "npm run build:site && npm run lighthouse:desktop:run",
    "lighthouse:desktop:run": "node scripts/run-lighthouse.mjs autorun --config=./config/lighthouserc.desktop.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "lighthouse": "13.5.0"
  }
}
